# Copy to .env (gitignored) for local runs, or export as environment variables.
# Caller bearer tokens are NEVER configured here; every request carries its own Authorization header.

RAG_AGENT_KB_BASE_URL=http://localhost:8080
RAG_AGENT_LLM_BASE_URL=http://127.0.0.1:1234/v1
RAG_AGENT_LLM_MODEL=google/gemma-4-26b-a4b-qat
RAG_AGENT_LLM_API_KEY=

# Optional runtime settings (defaults shown):
# RAG_AGENT_LLM_REASONING_EFFORT=
# RAG_AGENT_ENGINE=loop                  # loop | graph
# RAG_AGENT_POLICY=single                # single | decompose
# RAG_AGENT_TRACING=off                  # off | console
# RAG_AGENT_ENFORCE_RETRIEVAL=true
# RAG_AGENT_SESSION_DB_PATH=             # empty = in-memory; set path for SQLite WAL persistence
# RAG_AGENT_MAX_CONCURRENT_ASKS=0        # 0 = unlimited
# RAG_AGENT_BIND_HOST=127.0.0.1
